# Optional: set to a long, shared invite code to restrict registration to friends
DD_INVITE_CODE=
# A persistent writable volume path, e.g. /app/data on Railway
DD_DATA_DIR=./data
# Set 1 when behind HTTPS in production
DD_SECURE_COOKIES=0
# Optional if behind a TLS reverse proxy: https://daily-dynasty.example.com
DD_PUBLIC_ORIGIN=
